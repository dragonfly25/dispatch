{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_COMMAND_SESSION_START}}",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_COMMAND_PRE_TOOL_USE}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
