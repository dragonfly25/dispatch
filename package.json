{
  "name": "@dragonfly25/dispatch",
  "version": "0.1.0",
  "description": "Route coding-agent tasks across Claude Code, Codex and Antigravity subscriptions.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragonfly25/dispatch.git"
  },
  "bin": {
    "dispatch": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run test/security",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "docs:config": "tsup scripts/gen-config-reference.ts --no-config --format esm --platform node --target node22 --out-dir node_modules/.cache/dispatch-docs --silent && node node_modules/.cache/dispatch-docs/gen-config-reference.js"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "^15.1.0",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
